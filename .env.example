VITE_API_BASE_URL=https://api.glasspay.app

# Public URL of this app — used for absolute URLs (e.g. invite links, canonical URLs).
VITE_APP_URL=https://app.glasspay.app

# Public marketing site (separate repo/deployment: glass-waitlist-v1). Only
# needed when VITE_APP_URL points at a real app subdomain distinct from the
# marketing domain — falls back to https://glasspay.app if unset.
# VITE_MARKETING_URL=https://glasspay.app

# Required for the "Continue with Google" buttons on the sign-up/sign-in
# pages to work. Create an OAuth 2.0 Client ID (type: Web application) in
# Google Cloud Console > APIs & Services > Credentials, and add this app's
# origin(s) (e.g. http://localhost:5173 for dev, https://app.glasspay.app
# for prod) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Crisp Website ID for chat on every app route (public and signed-in).
# Use the same ID in each environment, or leave unset to disable chat.
# VITE_CRISP_WEBSITE_ID=your-crisp-website-id

# Controls the test-mode banner + Paystack test card details on the Payment
# Summary screen. REQUIRED and fail-closed: scripts/check-build-env.mjs
# refuses to build unless this is the literal string "true" or "false" --
# unset used to mean real money is charged (matching the live Paystack keys
# now in use). Set "true" only in a dev/staging environment still running
# Paystack test keys; production must be "false".
# VITE_TEST_MODE=false

# Required in production (local dev may leave it unset to avoid noise).
# Enables crash/error reporting (src/utils/monitoring.js) via Sentry —
# render crashes and 5xx/network API errors get reported; routine 4xx
# validation errors are filtered out as expected user-facing feedback, not
# bugs. Create a project at sentry.io and paste its DSN here — without it
# production runs blind (no alerts when payments blow up).
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional performance sampling once VITE_SENTRY_DSN is set (0..1). Defaults
# to 0.1 (10% of transactions) so API/transaction traces show up in Sentry
# without flooding the free tier. Set "0" for errors-only.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional kill switch / feature flags — a JSON object, inlined at build
# time. Example: {"paymentsDisabled":true} blocks every payment-initiation
# button and must be paired with a redeploy (see
# docs/runbooks/incident-rollback.md). Omit for all features on ({}).
# VITE_FLAGS={}

# Cloudinary image delivery (src/lib/cloudinary.js). Exposed to the browser
# — required or every Cloudinary image 404s. Public ids and the upload flow
# are documented in docs/cloudinary.md.
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Upload-script-only credentials (scripts/upload-assets-to-cloudinary.mjs).
# Server-side values, never shipped to the browser; keep them in .env (which
# is gitignored), not committed.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
